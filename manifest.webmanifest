{
  "id": "./",
  "name": "JB Perfume Lab",
  "short_name": "JB Perfume Lab",
  "description": "Laboratorio digital personal para formulación conceptual, análisis olfativo e identidad creativa.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#171216",
  "theme_color": "#171216",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/brand-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
